{
  "protocol_version": "franka_replay_v1",
  "freeze_stage": "before_any_cross_method_dynamics_comparison",

  "robot_model": "MuJoCo Menagerie Franka Emika Panda",
  "end_effector_body": "hand",

  "pusht_action_space": [0.0, 512.0],
  "workspace_mapping": {
    "type": "global_affine",
    "width_m": 0.20,
    "center": "official Panda home hand position",
    "z": "fixed at official home hand height"
  },

  "ik": {
    "type": "fixed-orientation 6D damped-least-squares",
